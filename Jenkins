pipeline {
    agent any

    environment {
        VENV_DIR = ".venv"
    }

    stages {

        stage('Cleanup Workspace') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('Checkout Code') {
            steps {
                echo 'Source code has been checked out successfully.'
            }
        }

        stage('Setup Python Virtual Environment') {
            steps {
                bat '''
                    python -m venv %VENV_DIR%
                    call %VENV_DIR%\\Scripts\\activate
                    python -m pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Run Tests') {
            steps {
                bat '''
                    call %VENV_DIR%\\Scripts\\activate
                    pytest --junitxml=reports\\results.xml --html=report.html --self-contained-html
                '''
            }
        }

        stage('Publish Test Results') {
            steps {
                junit 'reports/results.xml'
            }
        }

        stage('Archive HTML Report') {
            steps {
                archiveArtifacts artifacts: 'report.html', fingerprint: true, allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed.'

            archiveArtifacts artifacts: 'report.html', fingerprint: true, allowEmptyArchive: true

            junit allowEmptyResults: true, testResults: 'reports/results.xml'

            cleanWs()
        }

        success {
            echo 'Build completed successfully.'
        }

        failure {
            echo 'Build failed. Please check the console output.'
        }
    }
}
